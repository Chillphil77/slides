# Rosa Road — Advertising Content Automation Platform
# Copy this file to .env and fill in credentials you have.
# The app runs fine WITHOUT any credentials — it will use simulated data / dry-run mode.

# ---- App ----
APP_NAME="Rosa Road Studio"
SECRET_KEY="change-me-in-production-please-use-a-long-random-string"
ENVIRONMENT="development"
BASE_URL="http://localhost:8000"

# ---- Database ----
DATABASE_URL="sqlite:///./data/rosaroad.db"

# ---- AI: Google Gemini / Nano Banana 2 (image + text) ----
# Get a key: https://ai.google.dev
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-3.0-flash-image"

# ---- AI: Anthropic Claude (text, research, brand voice) ----
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-6"

# ---- Keyword / Trend research provider (optional) ----
SERPAPI_KEY=""

# ---- Social publishing credentials (optional — dry-run if empty) ----
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
FACEBOOK_PAGE_ID=""

LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_ORGANIZATION_URN=""

X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""

TIKTOK_ACCESS_TOKEN=""

# ---- Storage paths ----
UPLOAD_DIR="./uploads"
GENERATED_DIR="./generated"
DATA_DIR="./data"

# ---- Scheduler ----
SCHEDULER_ENABLED="true"
SCHEDULER_INTERVAL_SECONDS="30"
